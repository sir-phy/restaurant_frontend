# ── Backend connection (REST + Socket.IO) ───────────────────────────────────
# Base URL of restaurant_backend. Defaults to http://localhost:4000 when unset.
VITE_API_BASE_URL="http://localhost:4000"

# Socket.IO endpoint. Falls back to VITE_API_BASE_URL when unset.
#VITE_SOCKET_URL="http://localhost:4000"

# ── Vite dev server ─────────────────────────────────────────────────────────
# Set to "true" to disable Hot Module Replacement / file watching.
#DISABLE_HMR="true"

# ── Bakong / KHQR merchant configuration ────────────────────────────────────
# Embedded in the payment QR (not secret). Must match restaurant_backend/.env.
VITE_BAKONG_ACCOUNT_ID="merchant@acleda"
VITE_BAKONG_ACCOUNT_NAME="My Restaurant"
VITE_BAKONG_MERCHANT_NAME="My Restaurant"
VITE_BAKONG_MERCHANT_ID="RESTAURANT"
#VITE_BAKONG_ACQUIRING_BANK="ACLEDA"
VITE_BAKONG_MCC="5999"
VITE_BAKONG_MERCHANT_CITY="Phnom Penh"
VITE_BAKONG_CURRENCY="USD"
VITE_BAKONG_COUNTRY="KH"
